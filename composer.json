{
    "name": "laravel-gtm/route-hits",
    "description": "Record who hits which routes in your Laravel apps, with a small dashboard.",
    "license": "MIT",
    "homepage": "https://github.com/laravel-gtm/route-hits",
    "authors": [
        {
            "name": "Devon Garbalosa",
            "email": "devon@laravel.com"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelGtm\\RouteHits\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelGtm\\RouteHits\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelGtm\\RouteHits\\RouteHitsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
